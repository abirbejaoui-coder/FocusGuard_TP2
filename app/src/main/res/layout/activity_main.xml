<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FocusGuard AI"
        android:textAlignment="center"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bonjour !"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp" />

    <TextView
        android:id="@+id/txt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Prêt à te concentrer aujourd'hui ?"
        android:textAlignment="center"
        android:textSize="17sp"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/txt_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Temps étudié : 0 min"
        android:textAlignment="center"
        android:textSize="18sp"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/txt_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sessions terminées : 0"
        android:textAlignment="center"
        android:textSize="18sp"
        android:layout_marginTop="15dp" />

    <Button
        android:id="@+id/bt_new_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nouvelle session"
        android:layout_marginTop="35dp" />

    <Button
        android:id="@+id/bt_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Assistant FocusAI"
        android:layout_marginTop="15dp" />

    <Button
        android:id="@+id/bt_statistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mes statistiques"
        android:layout_marginTop="15dp" />

    <TextView
        android:id="@+id/txt_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Objectif du jour : 3 heures"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginTop="30dp" />

</LinearLayout>